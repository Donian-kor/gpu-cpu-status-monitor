{
  "name": "gpu-cpu-status-monitor",
  "displayName": "GPU/CPU Status Monitor",
  "description": "상태바에 CPU·RAM 사용률, GPU 사용률, 온도, VRAM 사용량을 표시합니다 (NVIDIA GPU 전용)",
  "version": "0.2.0",
  "publisher": "local-user",
  "repository": {
    "type": "git",
    "url": "https://github.com/Donian-kor/gpu-cpu-status-monitor.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gpuCpuMonitor.refresh",
        "title": "GPU/CPU Monitor: 지금 새로고침"
      }
    ],
    "configuration": {
      "title": "GPU/CPU Status Monitor",
      "properties": {
        "gpuCpuMonitor.updateInterval": {
          "type": "number",
          "default": 2000,
          "description": "상태바 업데이트 주기 (밀리초). 너무 짧게 설정하면 CPU 부하가 늘어납니다."
        },
        "gpuCpuMonitor.nvidiaSmiPath": {
          "type": "string",
          "default": "nvidia-smi",
          "description": "nvidia-smi 실행 파일 경로. PATH에 등록되어 있지 않다면 전체 경로를 입력하세요. 예: C:\\Windows\\System32\\nvidia-smi.exe"
        }
      }
    }
  }
}
